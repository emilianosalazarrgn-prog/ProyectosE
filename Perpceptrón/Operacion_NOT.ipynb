      "source": [
        "# Operación NOT\n",
        "#esta neurona lo que hace es darme el número contrario al que le doy\n",
        "#si le dos 1 da 0 y si le doy 0 da 1\n",
        "from sklearn.linear_model import Perceptron\n",
        "\n",
        "X = [[0], [1]]\n",
        "y = [1, 0]\n",
        "\n",
        "neurona = Perceptron()\n",
        "neurona.fit(X, y)\n",
        "\n",
        "print(neurona.predict(X))"
      ]
    }
  ]
